<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fa-solid fa-comments"></i>
            </div>
            <h2>Welcome Back</h2>
            <p>Sign in to continue to your real-time chat workspace</p>
        </div>

        <div id="errorAlert" class="alert alert-danger" style="display: none;"></div>

        <form id="loginForm" class="auth-form">
            <div class="form-group">
                <label for="email"><i class="fa-regular fa-envelope"></i> Email Address</label>
                <input type="email" id="email" name="email" required placeholder="name@example.com" autofocus autocomplete="email">
            </div>

            <div class="form-group">
                <label for="password"><i class="fa-solid fa-lock"></i> Password</label>
                <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password">
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
                <span>Sign In</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Don't have an account? <a href="/register">Create one here</a></p>
        </div>
    </div>
</div>

<script src="/js/auth.js"></script>
<%- include('partials/footer') %>

