<%- include('partials/header') %>

<div class="chat-app-container">
    <!-- SIDEBAR: Centralized Chats Section -->
    <aside class="chat-sidebar">
        <!-- Current User Profile Bar -->
        <header class="sidebar-header">
            <div class="user-profile-badge">
                <div class="avatar-wrapper">
                    <img src="<%= currentUser.profile_picture_url || '/images/default-avatar.png' %>" alt="<%= currentUser.name %>" class="user-avatar" onerror="this.src='/images/default-avatar.png'">
                    <span class="status-indicator online"></span>
                </div>
                <div class="user-info">
                    <h4 class="user-name"><%= currentUser.name %></h4>
                    <span class="user-handle">@<%= currentUser.username %></span>
                </div>
            </div>
            <div class="header-actions">
                <button id="btnNewDirect" class="btn-icon" title="New Direct Message">
                    <i class="fa-solid fa-user-plus"></i>
                </button>
                <button id="btnNewGroup" class="btn-icon" title="Create Group">
                    <i class="fa-solid fa-users"></i>
                </button>
                <a href="/profile" class="btn-icon" title="Settings / Profile">
                    <i class="fa-solid fa-gear"></i>
                </a>
                <a href="/logout" class="btn-icon logout-icon" title="Logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <!-- Search Bar: Users & Messages -->
        <div class="search-section">
            <div class="search-input-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="globalSearchInput" placeholder="Search chats, users, or messages..." autocomplete="off">
                <button id="clearSearchBtn" class="btn-icon clear-search" style="display: none;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <!-- Search Results Dropdown -->
            <div id="searchResultsContainer" class="search-results-dropdown" style="display: none;">
                <div class="search-tabs">
                    <button class="search-tab active" data-tab="users">Users</button>
                    <button class="search-tab" data-tab="messages">Messages</button>
                </div>
                <div id="searchUsersList" class="search-list"></div>
                <div id="searchMessagesList" class="search-list" style="display: none;"></div>
            </div>
        </div>

        <!-- Conversations List -->
        <div class="conversations-container">
            <div class="conversations-header">
                <h3>Chats</h3>
                <span id="unreadTotalBadge" class="badge-pill" style="display: none;">0</span>
            </div>
            <ul id="conversationList" class="conversation-list">
                <li class="loading-placeholder">
                    <i class="fa-solid fa-spinner fa-spin"></i> Loading chats...
                </li>
            </ul>
        </div>
    </aside>

    <!-- MAIN CHAT AREA -->
    <main class="chat-main" id="chatMain">
        <!-- Empty State (No Chat Selected) -->
        <div class="empty-chat-state" id="emptyChatState">
            <div class="empty-state-content">
                <div class="empty-icon-bubble">
                    <i class="fa-solid fa-comments"></i>
                </div>
                <h2>Real-Time Communication Platform</h2>
                <p>Select a conversation from the sidebar or start a new 1-to-1 or group chat to begin messaging.</p>
                <div class="empty-state-actions">
                    <button class="btn btn-primary" onclick="openNewDirectModal()">
                        <i class="fa-solid fa-user-plus"></i> New Message
                    </button>
                    <button class="btn btn-outline" onclick="openNewGroupModal()">
                        <i class="fa-solid fa-users"></i> Create Group
                    </button>
                </div>
            </div>
        </div>

        <!-- Active Chat Window (Hidden initially) -->
        <section class="active-chat-window" id="activeChatWindow" style="display: none;">
            <!-- Chat Topbar -->
            <header class="chat-header">
                <button id="mobileBackBtn" class="btn-icon mobile-only">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div class="chat-header-info" id="chatHeaderInfo">
                    <div class="avatar-wrapper">
                        <img id="chatHeaderAvatar" src="/images/default-avatar.png" alt="Avatar" class="user-avatar" onerror="this.src='/images/default-avatar.png'">
                        <span id="chatHeaderOnlineDot" class="status-indicator offline"></span>
                    </div>
                    <div class="header-details">
                        <h3 id="chatHeaderTitle">Chat Name</h3>
                        <p id="chatHeaderSubtitle" class="header-status">Offline</p>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button id="btnGroupInfo" class="btn-icon" title="Group Info / Members" style="display: none;">
                        <i class="fa-solid fa-circle-info"></i>
                    </button>
                    <button id="btnLeaveGroup" class="btn-icon text-danger" title="Leave Group" style="display: none;">
                        <i class="fa-solid fa-door-open"></i>
                    </button>
                </div>
            </header>

            <!-- Message Feed Area -->
            <div class="messages-container" id="messagesContainer">
                <div id="messagesFeed" class="messages-feed"></div>
            </div>

            <!-- Typing Indicator Bar -->
            <div id="typingIndicator" class="typing-indicator" style="display: none;">
                <span class="typing-dots">
                    <span></span><span></span><span></span>
                </span>
                <span id="typingText" class="typing-text">Someone is typing...</span>
            </div>

            <!-- Chat Input Area -->
            <footer class="chat-footer">
                <!-- Media Attachment Preview Bar -->
                <div id="attachmentPreviewBar" class="attachment-preview-bar" style="display: none;">
                    <div class="preview-card">
                        <div id="previewIconOrImg"></div>
                        <span id="previewFileName" class="preview-filename"></span>
                        <button type="button" id="removeAttachmentBtn" class="btn-icon btn-small">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <form id="messageForm" class="message-input-form">
                    <!-- Media Upload Trigger -->
                    <label for="mediaFileInput" class="btn-icon attachment-btn" title="Attach Image or Audio">
                        <i class="fa-solid fa-paperclip"></i>
                        <input type="file" id="mediaFileInput" accept="image/*,audio/*" style="display: none;">
                    </label>

                    <!-- Quick Emoji Picker Trigger -->
                    <div class="emoji-menu-wrapper">
                        <button type="button" id="emojiPickerBtn" class="btn-icon" title="Add Emoji">
                            <i class="fa-regular fa-face-smile"></i>
                        </button>
                        <div id="emojiPickerPopup" class="emoji-picker-popup" style="display: none;">
                            <span class="emoji-item">👍</span>
                            <span class="emoji-item">❤️</span>
                            <span class="emoji-item">😂</span>
                            <span class="emoji-item">😮</span>
                            <span class="emoji-item">😢</span>
                            <span class="emoji-item">🔥</span>
                            <span class="emoji-item">🎉</span>
                            <span class="emoji-item">👏</span>
                            <span class="emoji-item">🙏</span>
                            <span class="emoji-item">🚀</span>
                        </div>
                    </div>

                    <!-- Text Input Field -->
                    <div class="textarea-wrapper">
                        <textarea id="messageTextInput" placeholder="Type a message..." rows="1" autocomplete="off"></textarea>
                    </div>

                    <!-- Record Audio / File Voice Note Button -->
                    <button type="button" id="audioRecordBtn" class="btn-icon record-btn" title="Record Audio Message">
                        <i class="fa-solid fa-microphone"></i>
                    </button>

                    <!-- Send Button -->
                    <button type="submit" id="sendBtn" class="btn-icon send-btn" title="Send Message">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </footer>
        </section>
    </main>
</div>

<!-- ================= MODALS ================= -->

<!-- Modal: New Direct Message (User Search) -->
<div id="newDirectModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Start Direct Message</h3>
            <button class="btn-icon modal-close" onclick="closeModal('newDirectModal')">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="search-input-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="directUserSearchInput" placeholder="Search user by name or username...">
            </div>
            <div id="directUsersResultList" class="modal-user-list">
                <p class="empty-modal-text">Type to search registered users</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Group Chat -->
<div id="newGroupModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Create Chat Group</h3>
            <button class="btn-icon modal-close" onclick="closeModal('newGroupModal')">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form id="createGroupForm" class="modal-form">
            <div class="modal-body">
                <div class="form-group">
                    <label for="groupTitleInput">Group Name *</label>
                    <input type="text" id="groupTitleInput" name="title" required placeholder="e.g. Project Developers">
                </div>
                <div class="form-group">
                    <label for="groupDescInput">Description (Optional)</label>
                    <input type="text" id="groupDescInput" name="description" placeholder="Short description of the group">
                </div>
                <div class="form-group">
                    <label for="groupAvatarInput">Group Avatar</label>
                    <input type="file" id="groupAvatarInput" name="avatar" accept="image/*">
                </div>
                <div class="form-group">
                    <label>Select Members</label>
                    <div id="groupMembersSelectionList" class="modal-user-list selection-list">
                        <p class="empty-modal-text">Loading users...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('newGroupModal')">Cancel</button>
                <button type="submit" class="btn btn-primary" id="btnSubmitGroup">Create Group</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Group Info & Members -->
<div id="groupInfoModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Group Information</h3>
            <button class="btn-icon modal-close" onclick="closeModal('groupInfoModal')">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="group-info-summary">
                <img id="infoGroupAvatar" src="/images/default-group.png" alt="Group" class="group-large-avatar" onerror="this.src='/images/default-group.png'">
                <h4 id="infoGroupTitle">Group Title</h4>
                <p id="infoGroupDesc" class="group-info-desc"></p>
            </div>

            <div class="group-members-section">
                <div class="members-header">
                    <h4>Members (<span id="infoMemberCount">0</span>)</h4>
                    <button id="btnAddMemberBtn" class="btn btn-small btn-outline">
                        <i class="fa-solid fa-user-plus"></i> Add Member
                    </button>
                </div>
                <!-- Add Member Form (Toggled) -->
                <div id="addMemberFormContainer" style="display: none;" class="add-member-form-box">
                    <div class="search-input-wrapper">
                        <input type="text" id="addMemberSearchInput" placeholder="Search user to add...">
                    </div>
                    <div id="addMemberResults" class="modal-user-list mini-list"></div>
                </div>
                <div id="infoMemberList" class="group-member-list"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Message -->
<div id="editMessageModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card mini-card">
        <div class="modal-header">
            <h3>Edit Message</h3>
            <button class="btn-icon modal-close" onclick="closeModal('editMessageModal')">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form id="editMessageForm" class="modal-form">
            <div class="modal-body">
                <input type="hidden" id="editMessageId">
                <textarea id="editMessageContentInput" class="edit-textarea" rows="3" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('editMessageModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Image Lightbox -->
<div id="imageLightboxModal" class="modal-backdrop lightbox-backdrop" style="display: none;" onclick="closeModal('imageLightboxModal')">
    <div class="lightbox-content">
        <img id="lightboxImage" src="" alt="Full view">
    </div>
</div>

<!-- IN-APP TOAST NOTIFICATION CONTAINER -->
<div id="toastContainer" class="toast-container"></div>

<!-- PASS CURRENT USER JSON TO CLIENT SCRIPT -->
<script id="current-user-data" type="application/json">
    <%- JSON.stringify(typeof currentUser !== 'undefined' && currentUser ? currentUser : {}) %>
</script>
<script>
    const CURRENT_USER = JSON.parse(document.getElementById('current-user-data').textContent.trim() || '{}');
</script>

<!-- Socket.io Client Library -->
<script src="/socket.io/socket.io.js"></script>
<!-- Main Chat Application Client Logic -->
<script src="/js/chat.js"></script>

<%- include('partials/footer') %>

